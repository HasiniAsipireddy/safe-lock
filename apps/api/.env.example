NODE_ENV=development
PORT=4000

# --- Origins ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to send credentialed,
# state-changing requests. Matched by EXACT string equality by the originCheck
# middleware (never a prefix or regex) and used for the cors() allowlist.
# `CORS_ORIGINS` is still accepted as a legacy alias.
#
# PRODUCTION NOTE: sameSite=lax cookies are not sent across unrelated domains,
# so the web app and this API must be same-site (e.g. app.example.com and
# api.example.com). See docs/decisions.md.
# Dev tip: `next dev` moves to :3001 when :3000 is taken, so list both. Two
# exact origins, not a wildcard and not a pattern — a wildcard would also
# accept http://localhost:3000.attacker.test, and the production value must
# stay the real origins and nothing else.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001

# The ONE canonical base URL for links in outbound WhatsApp messages.
#
# Separate from WEB_ORIGIN on purpose: that is a comma-separated allowlist that
# may hold several origins, and a deep link needs exactly one. Optional outside
# production (defaults to http://localhost:3000, so local dev needs nothing).
# REQUIRED in production, where the boot fails unless it is https, not a
# loopback host, and free of placeholder text.
# PUBLIC_WEB_URL=https://app.example.test

# Trust X-Forwarded-* headers. Leave `false` unless actually behind a proxy:
# trusting it with no proxy in front lets any client spoof its IP and bypass
# every per-IP rate limit. Set to the number of proxy hops, or `true`.
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -----------------------------------------------------------------
# Two URLs, because a pooled connection and a migration need opposite things.
#
#   DATABASE_URL  the application's runtime connection
#   DIRECT_URL    the connection `prisma migrate` uses (prisma.config.ts)
#
# Locally they are identical — one Postgres, no pooler — and you can leave
# DIRECT_URL unset, in which case DATABASE_URL is used for migrations too.
#
# The dev database runs in Docker on host port 5433 (see docker-compose.yml) so
# it cannot clash with a PostgreSQL install already using the default 5432.
DATABASE_URL=postgresql://safelock:safelock_dev_only@localhost:5433/safelock
DIRECT_URL=postgresql://safelock:safelock_dev_only@localhost:5433/safelock

# Used by `vitest`. This database is TRUNCATED between tests — never point it at
# anything you care about. The suite refuses to start if this names a non-local
# host, whatever the database is called (src/test/localDatabaseGuard.ts), so
# leave it on Docker even when the two URLs above point at Supabase.
TEST_DATABASE_URL=postgresql://safelock:safelock_dev_only@localhost:5433/safelock_test

# --- Database: Supabase -------------------------------------------------------
# Replace the two URLs above with these shapes. Both come from the Supabase
# dashboard (Project Settings -> Database -> Connection string); `[PROJECT-REF]`,
# `[PASSWORD]` and `[REGION]` are yours. See "Running against Supabase" in
# README.md for the full sequence.
#
# RUNTIME — the TRANSACTION pooler, port 6543. One statement per pooled
# connection, which is what a request-per-connection web app wants.
#   DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&sslmode=require"
#
# MIGRATIONS — the SESSION pooler, port 5432. Migrate needs one backend for the
# whole run: it holds an advisory lock, runs CREATE EXTENSION and wraps DDL in
# long transactions, none of which survive transaction-mode pooling. Pointed at
# 6543 it fails or half-applies.
#   DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
#
# Deliberately the session pooler and NOT the direct host
# (db.[PROJECT-REF].supabase.co): that one resolves to IPv6 only and fails from
# most IPv4 networks.
#
# On the query parameters, which are not all equal:
#   sslmode=require      enforced, and the one that genuinely matters. Keep it
#                        on both URLs. `node-postgres` turns this into a
#                        verified TLS connection.
#   connection_limit=N   read by src/lib/prisma.ts and applied as the pg pool
#                        size. Supabase's guides say `1`, which is advice for
#                        serverless functions: this API is a long-lived process
#                        with an outbox worker and two sweepers, and a pool of
#                        one serialises all of them behind each other. Start
#                        around 10 and keep it under the pooler's own limit.
#   pgbouncer=true       inert here, and harmless. It told Prisma's old Rust
#                        engine to stop using named prepared statements; this
#                        app uses the pg driver adapter, which never names one.
#                        Kept because every Supabase guide includes it.

# --- Auth ---------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Signs the short-lived access token.
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
# Access token lifetime (any `ms`-style string jsonwebtoken accepts).
ACCESS_TOKEN_TTL=15m
# Refresh token lifetime, in days. Refresh tokens are opaque random bytes
# stored hashed in the RefreshToken table — nothing signs them.
REFRESH_TOKEN_TTL_DAYS=7
# LEGACY, unused: refresh tokens are no longer JWTs. Safe to omit.
# JWT_REFRESH_SECRET=

# --- Unlock OTP ---------------------------------------------------------------
# Keys the HMAC that unlock codes are stored under. Must be at least 32 chars;
# the API refuses to boot without it. Generate a SEPARATE value from
# JWT_ACCESS_SECRET — rotating one should not invalidate the other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In development the generated code is printed to the API console. That print
# is guarded by NODE_ENV and can never happen in production.
OTP_HMAC_SECRET=change_me_otp_hmac_secret_at_least_32_chars

# --- Device gateway and command protocol --------------------------------------
# See docs/device-protocol.md for the whole wire protocol.
#
# mock | mqtt
#
# LEAVE THIS AS `mock`. The MQTT transport is PARKED as of 2026-10-24: the
# website is being finished first and real hardware (an ESP32) comes after, so
# `mqtt` is refused at boot in every environment and needs NO broker, NO
# credential and NO command secret. Nothing was deleted — MqttDeviceGateway,
# lib/deviceProtocol, the simulator and docs/device-protocol.md are all still
# there, and the hardware phase resumes from them. To un-park, set
# MQTT_PARKED=false in apps/api/src/config/env.ts. See docs/decisions.md.
#
# `mock` answers like a real device: it signs an ack with the device's own
# derived key and hands it to the same inbound handler MQTT would, so the whole
# site works end to end — 202 and poll, lockState moving only on an ack,
# /history, notifications, the admin commands view. It is REFUSED in
# production, which means that while MQTT is parked NOTHING boots in
# production. That is deliberate: a rental product whose safes cannot be
# physically opened has nothing to sell.
DEVICE_GATEWAY=mock

# Master secret for per-device command keys. Each device's key is
#   HMAC-SHA256(this, "safelock:device-cmd:v1:" + keyVersion + ":" + serial)
# so there is ONE secret here and NO per-device key stored anywhere. Required
# (32+ chars) when DEVICE_GATEWAY=mqtt. Must differ from OTP_HMAC_SECRET: they
# protect different things and rotate on different schedules — and rotating
# this one is a fleet re-provisioning, not something to trip into.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# DEVICE_COMMAND_HMAC_SECRET=
# The keyVersion new credentials are derived at. Bump it to rotate the master
# secret without a flag day: devices keep working on the version they hold
# until they are re-provisioned one at a time.
DEVICE_COMMAND_KEY_VERSION=1

# How long the server waits for a device to ack. 15s sits under the ~20s a
# person will stare at a spinner, and is also the ttlMs the device enforces
# from its own monotonic counter.
COMMAND_TTL_MS=15000
# Past this, an ack is no longer correlated to its command — but the state it
# reports is still applied. Late is false; the measurement is still true.
COMMAND_LATE_ACK_MAX_MS=600000
# The timeout sweeper. Correctness never depends on it: the status endpoint
# derives "past its expiry" from the clock on every read.
COMMAND_SWEEP_INTERVAL_MS=5000
# Give-up point for a SYSTEM command's retries (backoff 10s, 60s, 300s). A user
# command never retries — nobody is waiting on a system lock, and the correct
# end state for it is not a judgement call.
COMMAND_MAX_ATTEMPTS=3
# Consecutive failed commands before a device is flagged for admins. One
# timeout is a lost packet; three in a row is a safe that needs a human.
COMMAND_FAILURE_FLAG_THRESHOLD=3

# Heartbeat cadence, and how long silence means offline. Three missed
# heartbeats, so one lost packet is not an outage. `online` is derived from the
# age of the last verified message on every read, never served from the stored
# boolean.
DEVICE_HEARTBEAT_SECONDS=60
DEVICE_OFFLINE_AFTER_SECONDS=180

# The broker, and the API's OWN privileged credential — never a device's. The
# server may write any cmd and read any report, and is denied write access to
# ack/state/status: it has no business forging a device report, so a
# compromised API credential cannot fabricate the security record.
# All three are required when DEVICE_GATEWAY=mqtt, and TLS is required in
# production. Local dev uses the Mosquitto container in docker-compose.yml.
# NOT NEEDED TODAY: `mqtt` is parked (see DEVICE_GATEWAY above), so leave these
# commented out and do not start the broker container.
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=safelock-api-local
# MQTT_PASSWORD=
MQTT_TIMEOUT_MS=5000

# --- Rental pricing -----------------------------------------------------------
# Hourly rate PER SAFE SIZE, in PAISE (INR x 100). 10000 = Rs 100/hour.
# These are the only place the rates are defined; the client never sends an
# amount and never multiplies one — the quote endpoint prices every
# (size, duration) pair the server would accept.
#
# PROVISIONAL, like the flat rate they replace — see CLAUDE.md's open
# questions. Rs 60 / Rs 100 / Rs 160 was chosen on 2026-10-25; medium
# deliberately equals the old flat rate, so existing devices (all backfilled to
# MEDIUM) are priced exactly as before.
#
# Every booking snapshots its size AND its rate at creation, so changing any of
# these never re-prices a booking that is already running — and reclassifying a
# cabinet in the admin panel does not either.
RENTAL_HOURLY_RATE_SMALL_PAISE=6000
RENTAL_HOURLY_RATE_MEDIUM_PAISE=10000
RENTAL_HOURLY_RATE_LARGE_PAISE=16000
# LEGACY: the single flat rate from before sizes existed. Still honoured as the
# default for RENTAL_HOURLY_RATE_MEDIUM_PAISE when that is unset, so an older
# .env keeps charging what it charged. An explicit medium rate wins.
# RENTAL_HOURLY_RATE_PAISE=10000
# Shortest and longest a single booking or extension may be, in whole hours.
RENTAL_MIN_HOURS=1
RENTAL_MAX_HOURS=24

# Overstay surcharge in BASIS POINTS: 15000 = 1.5x the hourly rate. Basis points
# rather than a decimal because money must never touch a float.
OVERSTAY_MULTIPLIER_BPS=15000
# Minutes after a booking ends before any fee accrues.
OVERSTAY_GRACE_MINUTES=15
# Most hours of overstay that can ever be charged. This is what bounds the bill
# for someone who walks away and never comes back.
OVERSTAY_CAP_HOURS=24
# Minutes to collect belongings after an overstay fee is settled.
COLLECTION_WINDOW_MINUTES=30

# How long an unpaid booking holds its safe. The device is reserved from
# creation, so a user who pays is never told "sorry, gone"; the Razorpay order
# expiry is set to match, which keeps the late-payment window small.
BOOKING_HOLD_MINUTES=10
# How long an overstay quote is binding. Fees keep accruing while the user is at
# the checkout, so the quoted amount is honoured for this long and the order
# carries the same expiry. A capture after it whose amount no longer covers the
# fee is flagged for a manual refund, never silently settled.
OVERSTAY_QUOTE_TTL_MINUTES=15
# How often the booking sweeper reconciles rows and releases safes. Correctness
# never depends on it: every read derives a booking's state from the clock.
BOOKING_SWEEP_INTERVAL_MS=60000

# --- Payments (Razorpay) ------------------------------------------------------
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_* keys in development.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# NEVER expose this to the frontend and never log it.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks. A separate secret you choose per webhook.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# --- ADMIN seed ---------------------------------------------------------------
# Used by `npm --workspace apps/api run db:seed`. There is no default password.
# Must be at least 12 characters; the script refuses anything shorter.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose_a_long_admin_password
SEED_ADMIN_NAME=Safe Lock Admin
SEED_ADMIN_PHONE=9800000001
# Required to let the seed run when NODE_ENV=production.
# SEED_ALLOW_PRODUCTION=true

# --- WhatsApp (Meta Cloud API) ------------------------------------------------
# Which client to use.
#   fake  — records messages in memory and sends nothing. Development and test
#           only: the API REFUSES TO BOOT with fake when NODE_ENV=production.
#   cloud — the real Graph API. Requires the four credentials below.
WHATSAPP_PROVIDER=fake

# Required when WHATSAPP_PROVIDER=cloud, in EVERY environment (a missing app
# secret would mean the delivery webhook cannot verify a signature, and
# "cannot verify" must never degrade to "accept").
#
# Where each comes from, in Meta's console (developers.facebook.com):
#   ACCESS_TOKEN     WhatsApp -> API Setup -> temporary token, or a System User
#                    token for production (the temporary one expires in 24h).
#   PHONE_NUMBER_ID  WhatsApp -> API Setup -> "Phone number ID" (NOT the number).
#   APP_SECRET       App Settings -> Basic -> App Secret. Keys the webhook HMAC.
#   VERIFY_TOKEN     A random string YOU choose; paste the same value into
#                    WhatsApp -> Configuration -> Webhook -> Verify token.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Approved template names, one per message kind. These defaults are the names
# to submit to Meta (see README "WhatsApp templates"); override if your
# WhatsApp Business account uses different ones.
# WHATSAPP_TEMPLATE_UNLOCK_OTP=safelock_unlock_code
# WHATSAPP_TEMPLATE_PHONE_OTP=safelock_phone_verification
# WHATSAPP_TEMPLATE_PASSWORD_RESET=safelock_password_reset
# WHATSAPP_TEMPLATE_UNLOCK_ALERT=safelock_unlock_alert
# WHATSAPP_TEMPLATE_FAILED_ATTEMPTS=safelock_failed_attempts
# Rental lifecycle templates. All UTILITY and purely informational: a body that
# pushes an upsell risks Meta reclassifying it as MARKETING, which users can
# mute — and a muted overstay notice means a fee nobody was told about.
# WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=safelock_booking_confirmed
# WHATSAPP_TEMPLATE_BOOKING_ENDING_SOON=safelock_booking_ending_soon
# WHATSAPP_TEMPLATE_OVERSTAY_STARTED=safelock_overstay_started
# WHATSAPP_TEMPLATE_OVERSTAY_SETTLED=safelock_overstay_settled
# WHATSAPP_TEMPLATE_COLLECTION_CLOSING=safelock_collection_closing

# Template language tag as registered with Meta, and the pinned Graph API
# version (pinned so Meta rolling forward cannot change behaviour).
# WHATSAPP_LANGUAGE=en
# WHATSAPP_API_VERSION=v21.0
# Per-request timeout. A send that hangs must not hold an unlock open.
# WHATSAPP_TIMEOUT_MS=8000

# USER-TRIGGERED messages per user per ROLLING 24 hours. Each one costs money
# and lands on a real phone, so an uncapped endpoint is both a billing risk and
# a way to use this product to harass someone. Unlock codes are exempt — a
# quota must never lock an owner out of their own safe.
#
# Covers PHONE_OTP, PASSWORD_RESET, UNLOCK_ALERT and FAILED_ATTEMPTS_ALERT:
# everything a user's own action produces. Booking lifecycle messages have
# their own budget below, so a chatty rental cannot eat a verification code.
# WHATSAPP_DAILY_SEND_CAP=10

# Booking lifecycle messages per user per ROLLING 24 hours. A separate budget,
# not an exemption: nothing a client can call creates these rows, but a day of
# two dozen extensions should still be bounded. Counts rows actually SENT, so
# reminders that were cancelled and re-created by an extension cost nothing.
# A message dropped by this cap is recorded SKIPPED/CAP_REACHED and shown in
# the admin view rather than disappearing.
# WHATSAPP_BOOKING_SEND_CAP=20

# How late a SCHEDULED booking message may be claimed and still sent. Past it
# the row is SKIPPED/STALE: "your booking ends in 10 minutes", delivered after
# it ended, is not a late message but a false one. Keep it well above
# OUTBOX_POLL_INTERVAL_MS (5s) — 5 minutes is sixty polls of headroom, so an
# ordinary restart or a slow deploy never discards a reminder.
# REMINDER_MAX_LATENESS_MINUTES=5

# --- Outbox worker ------------------------------------------------------------
# The poll loop that sends queued alerts after their transaction commits.
# Started from server.ts only, never from createApp().
# OUTBOX_POLL_INTERVAL_MS=5000
# Give-up point for one message. Backoff is 30s, 2m, 8m, 32m, capped at 1h.
# OUTBOX_MAX_ATTEMPTS=5
