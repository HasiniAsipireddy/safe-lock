// Safe Lock platform — database schema.
//
// Scope note: users, payments, device inventory/allocation and the lock/unlock
// flow are all here. `Command` (see CLAUDE.md "Data Model") is deliberately
// absent — the mock gateway acks synchronously, so there is nothing to track
// asynchronously or time out yet. It lands with the real MQTT gateway.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum DeviceStatus {
  UNASSIGNED
  ASSIGNED
  RETIRED
}

enum LockState {
  LOCKED
  UNLOCKED
  /// Only for a device nobody owns. An allocated safe is never UNKNOWN —
  /// allocation sets LOCKED, unassign sets it back to UNKNOWN.
  UNKNOWN
}

/// What happened to a safe. Append-only; the /history page reads these.
enum DeviceEventType {
  LOCK
  /// A one-time code was sent. Nothing has opened at this point.
  UNLOCK_REQUESTED
  UNLOCK_CONFIRMED
  /// A wrong, expired or exhausted code.
  UNLOCK_FAILED
}

/// Where a device event came from. Mobile and hardware join this later.
enum DeviceEventSource {
  WEB
}

/// Why an UNLOCK_FAILED event failed.
///
/// A closed enum, never free text: this is shown to the user and must never
/// carry anything derived from what was typed. Mirrors the `reason` the audit
/// trail already records (see deviceControl.service.ts). Events written before
/// this column existed are null and render as a generic "Unlock failed".
enum UnlockFailureReason {
  WRONG_CODE
  EXPIRED
  TOO_MANY_ATTEMPTS
  /// No code was outstanding — never requested, already used, or superseded.
  NO_CHALLENGE
}

/// Why a refresh token was revoked.
///
/// This exists for one decision: whether replaying the token should be treated
/// as **theft**. The reuse cascade is the right answer when we cannot know
/// which other sessions are compromised — but after a password change or reset
/// every token was already revoked deliberately, so cascading protects nothing
/// and its only effect is to log the user out of the device they just used.
/// See docs/decisions.md.
///
/// Null on rows revoked before this column existed; those keep the old
/// behaviour (treated as theft), which is the safe direction to be wrong in.
enum RefreshTokenRevokedReason {
  /// Redeemed normally and replaced by a successor. The grace window applies.
  ROTATED
  LOGOUT
  /// The user changed their own password, knowing the current one.
  PASSWORD_CHANGE
  /// A password reset link was redeemed.
  PASSWORD_RESET
  /// Collateral of a reuse detection, or of a family revocation.
  REUSE_CASCADE
}

/// What kind of message an outbound row carries.
///
/// One value per approved WhatsApp template. The template *name* comes from
/// configuration (Meta approves names per business account), so this enum
/// names the intent rather than the template.
enum OutboundMessageKind {
  /// The unlock one-time code. Authentication category.
  UNLOCK_OTP
  /// The phone-verification one-time code. Authentication category.
  PHONE_OTP
  /// A password reset link/token. Authentication category.
  PASSWORD_RESET
  /// "Your safe was opened." Utility category.
  UNLOCK_ALERT
  /// "Five wrong codes were entered." Utility category.
  FAILED_ATTEMPTS_ALERT
}

/// Where an outbound message got to.
///
/// `SKIPPED` is **not** a failure and is deliberately distinct from `FAILED`:
/// it means we decided not to send — no verified number, or no consent — so
/// nothing was attempted and nothing should be retried. Collapsing the two
/// would make a dashboard of delivery failures mostly noise, and would hide a
/// real provider outage inside a pile of "this user has no phone yet".
enum OutboundMessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Why a message was skipped or failed, as a closed set.
///
/// Mirrors `WhatsAppErrorCategory` in `lib/whatsapp/client.ts` plus the two
/// skip reasons. A category, never a provider message: the raw detail is
/// logged once and never stored, because a provider error string is
/// unbounded, unversioned text of exactly the kind that ends up quoted in a
/// UI by accident.
enum OutboundFailureCategory {
  /// Skip: the user has no verified phone number.
  NO_VERIFIED_PHONE
  /// Skip: the user has not opted in to WhatsApp.
  NO_CONSENT
  /// Skip: the user's daily send cap is spent.
  CAP_REACHED
  INVALID_NUMBER
  TEMPLATE
  AUTH
  RATE_LIMITED
  TRANSPORT
  UNKNOWN
}

/// What an in-app notification is about.
///
/// Deliberately not DeviceEventType: most device events notify nobody, and a
/// later non-device notification should not have to pose as a device event.
enum NotificationType {
  UNLOCK_CONFIRMED
  /// An unlock attempt that burned every attempt — a possible tampering
  /// signal, which is why it interrupts the owner. See docs/decisions.md.
  UNLOCK_FAILED_MAX_ATTEMPTS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// When the user confirmed a one-time code sent to `phone`.
  ///
  /// Null means unverified, and unverified means **no unlock** (the code has
  /// nowhere to go) and **no WhatsApp message of any kind**. Locking is still
  /// allowed: locking is the safe direction, and refusing it would leave
  /// someone unable to secure their own safe.
  ///
  /// There is no grandfathering. Nothing is deployed, so every account
  /// verifies — see docs/decisions.md.
  phoneVerifiedAt DateTime?

  /// When the user opted in to WhatsApp, and to which wording.
  ///
  /// Meta requires an explicit opt-in before a business may message someone.
  /// The version records *what* they agreed to (`WHATSAPP_CONSENT_VERSION` in
  /// `@safelock/shared`); "we have consent" is only meaningful if we can say
  /// which text it was. Both null until the user ticks the box.
  whatsappConsentAt      DateTime?
  whatsappConsentVersion Int?

  payments            Payment[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetCodes  PasswordResetCode[]
  outboundMessages    OutboundMessage[]
  phoneVerifications  PhoneVerification[]
  deviceEvents      DeviceEvent[]
  unlockChallenges  UnlockChallenge[]
  notifications     Notification[]
  /// At most one, enforced by the unique constraint on Device.ownerId.
  device            Device?
}

/// A physical safe lock in the inventory.
model Device {
  id           String       @id @default(cuid())
  serialNumber String       @unique
  status       DeviceStatus @default(UNASSIGNED)
  /// A safe ships locked, so a device in stock defaults to LOCKED and
  /// allocation re-asserts it. The UI must show the device's actual state,
  /// never "what the last button press implied" — hence lockStateUpdatedAt,
  /// which is set only when a command is *acked*, not when one is sent.
  lockState           LockState @default(LOCKED)
  lockStateUpdatedAt  DateTime?
  online              Boolean   @default(false)
  lastSeenAt          DateTime?

  /// Unique: a user owns at most one device for now. The constraint, not just
  /// a service check, is what makes concurrent allocation safe.
  ownerId     String?   @unique
  allocatedAt DateTime?

  /// Reserved for the hardware phase: a hash or key-reference for per-device
  /// credentials. **Never populated or returned by any endpoint today**, and
  /// excluded from every `select` list. No device secrets are stored yet.
  credentialHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  events           DeviceEvent[]
  unlockChallenges UnlockChallenge[]

  /// Supports the "oldest UNASSIGNED first" allocation pick.
  @@index([status, createdAt])
}

/// One row per lock/unlock event, append-only.
///
/// Separate from AuditLog on purpose: AuditLog is the internal security trail
/// (admin actions, failed logins, origin rejections) and is not shown to
/// users. This table is the **user-visible** activity feed that the /history
/// page will render, so it carries only what an owner should see.
///
/// Never holds an OTP, a hash of one, or any credential.
model DeviceEvent {
  id       String            @id @default(cuid())
  deviceId String
  userId   String
  type     DeviceEventType
  source   DeviceEventSource @default(WEB)

  /// Why an UNLOCK_FAILED failed. Null for every other type, and null on rows
  /// written before this column existed — deliberately not backfilled.
  failureReason UnlockFailureReason?

  /// The X-Request-Id of the request that caused this, so a user-visible
  /// event can be tied back to its server log lines. **Internal only** — it is
  /// in no `select` the /history endpoint uses.
  requestId String?

  createdAt DateTime @default(now())

  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications    Notification[]
  outboundMessages OutboundMessage[]

  /// The /history page's query: one user's events, newest first.
  ///
  /// `id` is part of the index because the page is keyset-paginated on
  /// `(createdAt DESC, id DESC)` — `createdAt` alone is not unique, and two
  /// events sharing a timestamp across a page boundary would otherwise be
  /// skipped or returned twice. See docs/decisions.md.
  @@index([userId, createdAt, id])
  @@index([deviceId, createdAt])
}

/// An in-app notification for one user.
///
/// Written in the **same transaction** as the device event it describes, so
/// there can never be a notification about an unlock that did not happen, nor
/// an unlock the owner was not told about. See lib/notifier/.
///
/// Carries no message text: the wording comes from NOTIFICATION_COPY in
/// @safelock/shared at render time, so copy can be fixed without a migration
/// and nothing user-supplied is ever stored here.
model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  /// The event that caused this. Nullable so a future notification that is not
  /// about a device event (an allocation, say) fits without a schema change.
  deviceEventId String?

  createdAt DateTime  @default(now())
  /// Null while unread. Marking read is idempotent — only null rows are moved.
  readAt    DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceEvent DeviceEvent? @relation(fields: [deviceEventId], references: [id], onDelete: SetNull)

  /// The bell's query: this user's notifications, unread first, newest first.
  @@index([userId, readAt, createdAt])
}

/// An outstanding phone-verification code.
///
/// Separate from `UnlockChallenge`, which is bound to a device — this one is
/// bound to a *candidate number*, and that difference is the point: the number
/// being verified is held **here** and only written to `User.phone` once the
/// code is confirmed. So changing a verified number leaves the old one live
/// and receiving codes until the new one is proved, and an abandoned change
/// costs the user nothing.
///
/// Only an HMAC of the code is stored, under the same `OTP_HMAC_SECRET` and
/// for the same reason as `UnlockChallenge`: a 6-digit space is 10^6, so the
/// key living outside the database is what protects the digest.
model PhoneVerification {
  id     String @id @default(cuid())
  userId String

  /// The number being verified, E.164. Not yet on the `User` row.
  phoneE164 String

  /// HMAC-SHA256(code, OTP_HMAC_SECRET), hex.
  otpHash String

  expiresAt DateTime
  attempts  Int       @default(0)
  /// Set on success, **or** when a newer request superseded this one.
  consumedAt DateTime?

  /// Captured at request time for the audit trail, never for auth.
  requestedIp String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding the one open verification for a user.
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// An outstanding unlock OTP.
///
/// Only an HMAC of the code is stored — never the code itself. A 6-digit
/// space is just 10^6, so a slow hash buys little; what protects it is a key
/// (OTP_HMAC_SECRET) held outside the database. See docs/decisions.md.
model UnlockChallenge {
  id       String @id @default(cuid())
  userId   String
  deviceId String

  /// HMAC-SHA256(code, OTP_HMAC_SECRET), hex. The plaintext code exists only
  /// in memory and in the notification, never at rest.
  otpHash String

  expiresAt DateTime
  /// Wrong guesses so far. At OTP_MAX_ATTEMPTS the challenge is dead.
  attempts  Int       @default(0)
  /// Set when the code was accepted, or when the challenge was superseded by
  /// a newer request. Either way it can never be used again.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding the one open challenge for a user's device.
  @@index([userId, deviceId, consumedAt])
  @@index([expiresAt])
}

/// One row per issued refresh token.
///
/// Refresh tokens are **opaque random bytes**, not JWTs, so they can be
/// revoked server-side the instant theft is suspected. Only the SHA-256 of the
/// token is stored: a database leak therefore yields no usable session.
///
/// Rotation: redeeming a token revokes it and links the successor through
/// `replacedById`. Tokens sharing a `familyId` are one login's chain — if a
/// revoked token is replayed outside the grace window the whole family is
/// revoked at once. See refreshToken.service.ts.
model RefreshToken {
  id String @id @default(cuid())

  userId String
  /// SHA-256 hex of the opaque token. Unique so a hash collision or a double
  /// insert cannot produce two live rows for one secret. The raw token is
  /// never stored, logged, or recoverable from this row.
  tokenHash String @unique
  /// Shared by every token descended from one login.
  familyId  String

  expiresAt DateTime
  revokedAt DateTime?
  /// Why it was revoked — specifically, whether a replay is theft. See the
  /// enum. Null for a live token, and for rows revoked before the column
  /// existed.
  revokedReason RefreshTokenRevokedReason?
  /// The token issued when this one was redeemed.
  replacedById String?
  /// Set when this already-revoked token was replayed inside the grace window
  /// and allowed to mint one sibling. A second such replay is treated as
  /// reuse: at most one sibling per rotated token.
  graceUsedAt DateTime?

  /// Captured at issue time to make an audit trail useful, never for auth.
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// The WhatsApp outbox: one row per message we intend to send.
///
/// ## Why an outbox exists at all
/// A WhatsApp send is a network call, and the unlock flow writes its
/// `DeviceEvent` and in-app `Notification` inside a transaction. Sending from
/// inside that transaction would be wrong in both directions: a rollback
/// cannot unsend a message (so someone could be told their safe opened when it
/// did not), and a WhatsApp outage would roll back the unlock (so the safe
/// would refuse to open because a *notification* channel was down).
///
/// Writing a row is a local insert, so it stays atomic with the event. The
/// worker sends after the commit. That reverses the step-2 trade-off — where a
/// notifier failure deliberately blocked the unlock — **for the external
/// channel only**. The in-app notification is still atomic and still blocking.
/// See docs/decisions.md.
///
/// ## What it never holds
/// No message text and no template parameters. Parameters can contain a
/// one-time code, so they are rebuilt from live data at send time
/// (`lib/whatsapp/send.ts`) and exist only in memory. A dump of this table
/// yields who was messaged about what, and no codes.
model OutboundMessage {
  id     String              @id @default(cuid())
  userId String
  kind   OutboundMessageKind

  status   OutboundMessageStatus   @default(PENDING)
  /// Delivery attempts so far. Compared against OUTBOX_MAX_ATTEMPTS.
  attempts Int                     @default(0)
  /// Why it failed or was skipped. Null while PENDING or once SENT.
  failureCategory OutboundFailureCategory?

  /// Earliest time the worker may try again. Exponential backoff.
  nextAttemptAt DateTime @default(now())

  /// Meta's `wamid.…`, once accepted. The key a delivery webhook matches on.
  providerMessageId String? @unique
  /// Delivery state reported by the webhook: sent / delivered / read / failed.
  deliveryStatus    String?
  deliveryUpdatedAt DateTime?

  /// The device event this message is about, when there is one.
  deviceEventId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceEvent DeviceEvent? @relation(fields: [deviceEventId], references: [id], onDelete: SetNull)

  /// The worker's claim query: PENDING rows whose backoff has elapsed.
  @@index([status, nextAttemptAt])
  /// The daily cap count, and a user's message history.
  @@index([userId, createdAt])
}

/// An outstanding password reset code.
///
/// Replaces the long-token link of step 3. The token was 32 random bytes in a
/// URL, which nothing could deliver: the WhatsApp message deliberately carries
/// no token (a chat message is persistent and forwardable), and there is no
/// email sender. An undeliverable credential is unreachable auth surface, so
/// it is gone. See docs/decisions.md.
///
/// `codeHash` is `HMAC-SHA256("pwreset:v1:" + code, OTP_HMAC_SECRET)`. **Keyed,
/// unlike the token it replaces** — and for the reason the step 3 entry gave
/// for *not* keying it: an unkeyed hash is reversible exactly when the input
/// space is small enough to enumerate, and 10^8 is. The `pwreset:v1:` prefix
/// is domain separation, so a reset digest can never equal an unlock digest for
/// the same digits even though both use the same secret.
///
/// There is no unique index on `codeHash`: codes are looked up by `userId`
/// (resolved from the submitted identifier), and two users may legitimately
/// hold the same 8 digits.
model PasswordResetCode {
  id     String @id @default(cuid())
  userId String

  /// HMAC of the code. The code itself exists only in memory and in the
  /// message — never stored, never logged, never in a response.
  codeHash String

  expiresAt DateTime
  /// Wrong guesses so far. **Load-bearing**: an 8-digit code is only safe
  /// because this is enforced atomically, in the `where` of the incrementing
  /// update. See passwordReset.service.ts.
  attempts  Int       @default(0)
  /// Set on success, when the attempt limit is burned, or when a newer request
  /// superseded this one. Either way it can never be used again.
  consumedAt DateTime?

  /// Captured at request time for the audit trail, never for auth.
  requestedIp String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding a user's one open code.
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// One row per Razorpay order. Amounts are integers in paise — never floats.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  /// Set when the payment first reaches PAID, by whichever of
  /// /payments/verify or the webhook gets there first.
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Razorpay webhook idempotency ledger. A delivery whose event id is already
/// here is acknowledged and dropped without being applied a second time.
model WebhookEvent {
  id          String   @id @default(cuid())
  /// Razorpay's `x-razorpay-event-id` header.
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  deviceId  String?
  action    String
  ip        String?
  userAgent String?
  /// Never holds secrets, signatures or OTPs — see audit.service.ts.
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
