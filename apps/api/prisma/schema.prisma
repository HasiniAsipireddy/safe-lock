// Safe Lock platform — database schema.
//
// Scope note: users, payments, device inventory and the lock/unlock flow are
// all here. `Command` landed with the MQTT gateway (docs/device-protocol.md):
// a transport that can lose, delay or duplicate a message gives a command a
// life of its own, so it needs a row, a sequence number and a timeout.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

/// Whether a safe can be rented.
///
/// `ASSIGNED` is gone with the purchase model: a device is no longer owned by
/// anybody, and occupancy is a property of its bookings.
/// How big a safe is, and therefore what it costs per hour.
/// Mirrors `SafeSize` in @safelock/shared.
///
/// An enum, not a volume: the price is per size, stock is counted per size, and
/// a renter picks from a menu of three. A litres column would turn every price
/// lookup into a range query to answer a question nobody asks.
enum SafeSize {
  SMALL
  MEDIUM
  LARGE
}

enum DeviceStatus {
  /// In the pool and bookable.
  AVAILABLE
  /// A booking ended without the renter confirming they took their things —
  /// the collection window lapsed, or an admin force-completed it. **Not
  /// bookable** until a human has looked inside and cleared it, because the
  /// alternative is handing the next renter a safe containing someone else's
  /// property, with the ability to unlock it.
  NEEDS_INSPECTION
  RETIRED
}

/// Where a booking is in its life. Mirrors `BookingStatus` in @safelock/shared.
enum BookingStatus {
  PENDING_PAYMENT
  ACTIVE
  OVERSTAY
  COMPLETED
  CANCELLED
  EXPIRED_UNPAID
}

/// How a booking ended, and therefore whether the safe needs inspecting.
enum BookingCompletionReason {
  /// The renter said they have their belongings. The only reason that returns
  /// the device to the pool automatically.
  COLLECTED
  COLLECTION_WINDOW_LAPSED
  ADMIN_FORCE_COMPLETED
}

/// What a payment is for. One Razorpay order per payment, always.
enum PaymentPurpose {
  BOOKING
  EXTENSION
  OVERSTAY
}

/// Why a captured payment needs a human.
///
/// A row carrying one of these is **real money we have taken and could not
/// apply**. It stays `PAID` — never pretend otherwise — and is listed for an
/// admin to refund by hand. See docs/decisions.md.
enum PaymentReviewReason {
  /// Captured after the booking's hold lapsed, and the device had been taken.
  BOOKING_EXPIRED_DEVICE_TAKEN
  /// Captured against a quote past its TTL whose fee had since grown.
  OVERSTAY_QUOTE_EXPIRED
  /// The booking was cancelled or completed before the money arrived.
  BOOKING_NO_LONGER_PAYABLE
}

enum LockState {
  LOCKED
  UNLOCKED
  /// We do not know. A device that has never reported, or one whose report we
  /// could not verify. Refused rather than guessed at — `assertCanOperate`
  /// throws `DEVICE_STATE_UNKNOWN` rather than sending a bolt command on a
  /// state it cannot reason about.
  UNKNOWN
}

/// Whether the safe's door is shut, as measured by its sensor.
///
/// **Units ship with a door sensor, and a unit without one is not supported
/// for rentals** (decided 2026-10-19, docs/device-protocol.md §11.8). Without
/// it, "locked" cannot be distinguished from "bolt extended into thin air",
/// which is the one check the completion flow actually needs.
///
/// `UNKNOWN` therefore means *we do not know* — a failed sensor
/// (`SENSOR_FAULT`), or firmware that has not read it yet — and never "there
/// is no sensor". It is a fault to surface, not a configuration to support.
/// Not nullable, because a nullable column invites "absent means closed",
/// which is the wrong direction to guess in when someone's property is inside.
enum DoorState {
  CLOSED
  OPEN
  UNKNOWN
}

/// The two things a safe can be told to do.
///
/// Two values rather than a parameterised command, mirroring the two
/// `DeviceGateway` methods: unlocking has a precondition (a verified OTP) that
/// locking does not, and that asymmetry should be visible at every call site.
enum CommandType {
  LOCK
  UNLOCK
}

/// Where a command got to.
///
/// `EXPIRED` and `TIMED_OUT` are distinct because they fail differently.
/// `TIMED_OUT` means the device did not answer — it may well have acted, so
/// the physical state is genuinely unknown and needs reconciling. `EXPIRED`
/// means the command never left the building (broker down, or the process died
/// between commit and publish), so we know nothing moved and a retry is safe.
/// Collapsing them would force one response to two opposite situations.
enum CommandStatus {
  /// Row committed, nothing published yet. Publishing happens after the
  /// commit, never inside the transaction — a rollback cannot un-publish.
  PENDING
  /// The broker accepted the publish (PUBACK).
  SENT
  /// The device acked `OK`: it acted and the mechanism got there.
  ACKED
  /// The device refused it before acting. Nothing moved.
  REJECTED
  /// The device tried and the mechanism did not get there.
  FAILED
  /// Published, no ack by `expiresAt`.
  TIMED_OUT
  /// Never published before `expiresAt`.
  EXPIRED
  /// Withdrawn before it could settle, because its premise stopped being true
  /// — a late ack proving the bolt already moved, or a device state change
  /// that makes a queued system retry pointless.
  CANCELLED
}

/// Why a command did not succeed, as a closed set.
///
/// The first group mirrors the device's ack `reason` enum
/// (docs/device-protocol.md §4.1); the last three are server-side failures the
/// device never saw. Never a broker or provider string — exactly the rule
/// `OutboundFailureCategory` follows, and for the same reason: an unbounded,
/// unversioned error string is the kind of thing that ends up quoted in a UI.
enum CommandFailureCategory {
  // --- The device refusing (REJECTED) ---
  BAD_VERSION
  BAD_KEY_VERSION
  WRONG_DEVICE
  BAD_SIGNATURE
  SEQ_REPLAY
  DUPLICATE
  EXPIRED
  /// A second command arrived while one was in flight. The device holds no
  /// queue, by design.
  UNSUPPORTED

  // --- The mechanism failing (FAILED) ---
  MOTOR_FAULT
  JAMMED
  DOOR_OBSTRUCTED
  LOW_POWER
  SENSOR_FAULT

  // --- Our side ---
  /// Published, never acked.
  NO_ACK
  /// The broker rejected or dropped the publish.
  PUBLISH_FAILED
  /// Still `PENDING` at its expiry: it never reached the broker at all.
  NOT_PUBLISHED
  /// Withdrawn deliberately. See `CommandStatus.CANCELLED`.
  SUPERSEDED
}

/// Who asked for a command, when it was not a user.
///
/// Exactly one of `Command.userId` and `Command.systemActor` is set. A system
/// command has nobody waiting on an answer, which is what licenses it to retry
/// — see docs/device-protocol.md §6.2 and §8.
enum CommandActor {
  /// The completion lock, issued when a booking ends.
  COMPLETION
  /// The reconciler: a safe reported itself open with no booking entitled to
  /// have it open (§8.3), or a timeout needed following up.
  SWEEPER
  /// An admin acting on a device directly.
  ADMIN
}

/// What happened to a safe. Append-only; the /history page reads these.
enum DeviceEventType {
  LOCK
  /// A one-time code was sent. Nothing has opened at this point.
  UNLOCK_REQUESTED
  UNLOCK_CONFIRMED
  /// A wrong, expired or exhausted code.
  UNLOCK_FAILED
}

/// Where a device event came from. Mobile and hardware join this later.
enum DeviceEventSource {
  WEB
}

/// Why an UNLOCK_FAILED event failed.
///
/// A closed enum, never free text: this is shown to the user and must never
/// carry anything derived from what was typed. Mirrors the `reason` the audit
/// trail already records (see deviceControl.service.ts). Events written before
/// this column existed are null and render as a generic "Unlock failed".
enum UnlockFailureReason {
  WRONG_CODE
  EXPIRED
  TOO_MANY_ATTEMPTS
  /// No code was outstanding — never requested, already used, or superseded.
  NO_CHALLENGE

  // --- The code was right and the safe still did not open. ------------------
  // Four new ways to fail, all of them *after* a correct code, which the mock
  // gateway could not produce: it acked synchronously and always. Existing
  // rows and existing reasons are untouched.

  /// The command was published and the device never answered. The physical
  /// state is genuinely unknown — it may have opened. See §5.5 on late acks.
  DEVICE_TIMEOUT
  /// The device refused the command before acting. Nothing moved.
  DEVICE_REJECTED
  /// The device tried and the mechanism did not get there.
  DEVICE_FAILED
  /// We could not reach the device at all, so no command was issued.
  DEVICE_OFFLINE
}

/// Why a refresh token was revoked.
///
/// This exists for one decision: whether replaying the token should be treated
/// as **theft**. The reuse cascade is the right answer when we cannot know
/// which other sessions are compromised — but after a password change or reset
/// every token was already revoked deliberately, so cascading protects nothing
/// and its only effect is to log the user out of the device they just used.
/// See docs/decisions.md.
///
/// Null on rows revoked before this column existed; those keep the old
/// behaviour (treated as theft), which is the safe direction to be wrong in.
enum RefreshTokenRevokedReason {
  /// Redeemed normally and replaced by a successor. The grace window applies.
  ROTATED
  LOGOUT
  /// The user changed their own password, knowing the current one.
  PASSWORD_CHANGE
  /// A password reset link was redeemed.
  PASSWORD_RESET
  /// Collateral of a reuse detection, or of a family revocation.
  REUSE_CASCADE
}

/// What kind of message an outbound row carries.
///
/// One value per approved WhatsApp template. The template *name* comes from
/// configuration (Meta approves names per business account), so this enum
/// names the intent rather than the template.
enum OutboundMessageKind {
  /// The unlock one-time code. Authentication category.
  UNLOCK_OTP
  /// The phone-verification one-time code. Authentication category.
  PHONE_OTP
  /// A password reset link/token. Authentication category.
  PASSWORD_RESET
  /// "Your safe was opened." Utility category.
  UNLOCK_ALERT
  /// "Five wrong codes were entered." Utility category.
  FAILED_ATTEMPTS_ALERT

  // --- Rental lifecycle. Utility category, and all five are *scheduled*: ----
  // they carry a `bookingId`, a `sendAt` that is a real deadline rather than
  // "now", and a `dedupeKey`. The worker re-validates every one of them
  // against the live booking before sending, so none can ever assert
  // something that stopped being true after it was queued.

  /// "Safe X is yours until Y." Sent at activation, and again after an
  /// extension — the sentence an extension needs is the same sentence.
  BOOKING_CONFIRMED
  /// "Your booking ends at Y." One row per lead time.
  BOOKING_ENDING_SOON
  /// "Your booking ended and an overstay fee has started."
  OVERSTAY_STARTED
  /// "We received your overstay payment." Never sent for a *waived* fee: a
  /// write-off worded as a receipt would be a lie about money. See
  /// docs/decisions.md.
  OVERSTAY_SETTLED
  /// "Your collection window closes at Y."
  COLLECTION_CLOSING
}

/// Where an outbound message got to.
///
/// `SKIPPED` is **not** a failure and is deliberately distinct from `FAILED`:
/// it means we decided not to send — no verified number, or no consent — so
/// nothing was attempted and nothing should be retried. Collapsing the two
/// would make a dashboard of delivery failures mostly noise, and would hide a
/// real provider outage inside a pile of "this user has no phone yet".
enum OutboundMessageStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Why a message was skipped or failed, as a closed set.
///
/// Mirrors `WhatsAppErrorCategory` in `lib/whatsapp/client.ts` plus the two
/// skip reasons. A category, never a provider message: the raw detail is
/// logged once and never stored, because a provider error string is
/// unbounded, unversioned text of exactly the kind that ends up quoted in a
/// UI by accident.
enum OutboundFailureCategory {
  /// Skip: the user has no verified phone number.
  NO_VERIFIED_PHONE
  /// Skip: the user has not opted in to WhatsApp.
  NO_CONSENT
  /// Skip: the user's daily send cap is spent.
  ///
  /// Also the reason a *scheduled* booking message is dropped once the
  /// separate booking budget is spent. Those rows are surfaced in the admin
  /// view on purpose: a dropped `OVERSTAY_STARTED` is a user who was never
  /// told a fee had started, which must be visible rather than silent.
  CAP_REACHED
  /// Skip: the booking this message was about moved on, so the message is no
  /// longer true — collected, cancelled, completed, or the fee already paid.
  /// Written by `cancelPending` at the state change.
  CANCELLED
  /// Skip: re-validation at send time refused it.
  ///
  /// Deliberately distinct from `CANCELLED`, which is often the *same
  /// situation* caught by the other guard: cancellation runs at the state
  /// change, re-validation runs at the send, and the two are independent on
  /// purpose. Two reasons means the data says which guard caught it, and a
  /// pile of `NOT_APPLICABLE` is the signal that some state change is failing
  /// to cancel what it should.
  NOT_APPLICABLE
  /// Skip: claimed too long after `sendAt` to still be honest.
  ///
  /// "Your booking ends in 10 minutes", delivered 40 minutes after it ended,
  /// is not a late message but a false one. Only ever applies to scheduled
  /// booking kinds; a message describing an event that already happened has
  /// no deadline to miss.
  STALE
  INVALID_NUMBER
  TEMPLATE
  AUTH
  RATE_LIMITED
  TRANSPORT
  UNKNOWN
}

/// What an in-app notification is about.
///
/// Deliberately not DeviceEventType: most device events notify nobody, and a
/// later non-device notification should not have to pose as a device event.
enum NotificationType {
  UNLOCK_CONFIRMED
  /// An unlock attempt that burned every attempt — a possible tampering
  /// signal, which is why it interrupts the owner. See docs/decisions.md.
  UNLOCK_FAILED_MAX_ATTEMPTS
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// When the user confirmed a one-time code sent to `phone`.
  ///
  /// Null means unverified, and unverified means **no unlock** (the code has
  /// nowhere to go) and **no WhatsApp message of any kind**. Locking is still
  /// allowed: locking is the safe direction, and refusing it would leave
  /// someone unable to secure their own safe.
  ///
  /// There is no grandfathering. Nothing is deployed, so every account
  /// verifies — see docs/decisions.md.
  phoneVerifiedAt DateTime?

  /// When the user opted in to WhatsApp, and to which wording.
  ///
  /// Meta requires an explicit opt-in before a business may message someone.
  /// The version records *what* they agreed to (`WHATSAPP_CONSENT_VERSION` in
  /// `@safelock/shared`); "we have consent" is only meaningful if we can say
  /// which text it was. Both null until the user ticks the box.
  whatsappConsentAt      DateTime?
  whatsappConsentVersion Int?

  payments            Payment[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetCodes  PasswordResetCode[]
  outboundMessages    OutboundMessage[]
  phoneVerifications  PhoneVerification[]
  deviceEvents      DeviceEvent[]
  unlockChallenges  UnlockChallenge[]
  notifications     Notification[]
  bookings            Booking[]
}

/// A physical safe lock in the inventory.
///
/// **Nobody owns a device.** The purchase model's `ownerId` is gone: a safe is
/// occupied for the duration of a `Booking` and free otherwise, and the
/// database enforces that no two bookings can occupy one at the same time (see
/// the exclusion constraint on `Booking`).
model Device {
  id           String       @id @default(cuid())
  serialNumber String       @unique
  status       DeviceStatus @default(AVAILABLE)

  /// How big this cabinet is. Drives the hourly rate and the booking pick.
  ///
  /// Defaults to `MEDIUM`, which is also what every row existing before this
  /// column was added was backfilled to — the rate `MEDIUM` carries is the flat
  /// rate those safes were already being rented at, so the backfill re-prices
  /// nothing. An admin reclassifies from the Devices tab; doing so does **not**
  /// change any live booking, which snapshots its own size and rate.
  size SafeSize @default(MEDIUM)
  /// A safe ships locked, so a device in stock defaults to LOCKED and
  /// allocation re-asserts it. The UI must show the device's actual state,
  /// never "what the last button press implied" — hence lockStateUpdatedAt,
  /// which is set only when a command is *acked*, not when one is sent.
  lockState           LockState @default(LOCKED)
  lockStateUpdatedAt  DateTime?
  /// The device's own claim, from its retained `/status` topic and its last
  /// will. **Never the authority on its own** — `online` is derived on read
  /// from `lastSeenAt` as well, so a stale retained flag or a broker that lost
  /// a will cannot be the whole answer. Same reflex as
  /// `effectiveBookingStatus`. See docs/device-protocol.md §6.1.
  online              Boolean   @default(false)
  /// Advanced by **any** verified inbound message — ack, state or status.
  lastSeenAt          DateTime?

  /// Whether the door is shut, as last measured. Distinct from `lockState`:
  /// a bolt can be extended with the door standing open, and the completion
  /// flow needs to tell those apart. See `DoorState`.
  doorState           DoorState @default(UNKNOWN)

  // --- What the device reports about itself. Diagnostics, never authority. ---

  firmwareVersion String?
  /// Wi-Fi signal strength in dBm. Present because the single most likely
  /// field failure is a safe on the edge of range inside a metal box, and that
  /// is far cheaper to diagnose from a number than from a site visit.
  rssi            Int?
  /// Whether the device's SNTP sync succeeded. A device with no time source
  /// still operates normally — replay protection comes from `commandSeq`, not
  /// from a clock — so this is shown to admins and gates nothing.
  clockSynced     Boolean?
  /// Random per boot. How the server notices a restart even if it missed the
  /// `BOOT` state report.
  bootId          String?

  /// Next command sequence number, allocated under the device row lock.
  ///
  /// Strictly increasing per device, and the device persists the highest it has
  /// seen, so a captured command cannot be replayed: its number is spent. A
  /// rolled-back transaction leaves a gap, which is fine — the device requires
  /// *increasing*, not contiguous.
  commandSeq Int @default(0)

  /// Set when a system LOCK exhausted its retries without an ack.
  ///
  /// The escalation the roadmap owed this path: today's best-effort version can
  /// record a safe as closed while it stands physically open. A device carrying
  /// this is flagged for admins and moved to `NEEDS_INSPECTION`.
  lockCommandFailedAt DateTime?

  /// Set when the device reported itself `UNLOCKED` with no booking entitled to
  /// have it open, and cleared when a later report shows it `LOCKED`.
  ///
  /// Flagged **on issue** of the reconciling LOCK rather than on its failure: a
  /// safe found open with nobody entitled to it is already an incident, and the
  /// lock succeeding makes it a resolved one rather than a non-event. See
  /// docs/device-protocol.md §8.3.
  unexpectedUnlockAt DateTime?

  /// Set when a booking ended without the renter confirming collection, and
  /// cleared by an admin with an audited note. A device with this set is not
  /// bookable — see `DeviceStatus.NEEDS_INSPECTION`.
  inspectionNote    String?
  inspectionNotedAt DateTime?

  /// `sha256` of the device's MQTT password, set when a credential is minted
  /// and nulled when the device is retired.
  ///
  /// **Never returned by any endpoint**, in no `select` list, and asserted
  /// absent by the admin no-secrets test. The password itself is shown exactly
  /// once, at issue, and there is no endpoint that reads one back.
  ///
  /// Note what is *not* here: the device's command key `K_d`. That is derived
  /// on demand from one server-side master secret
  /// (`DEVICE_COMMAND_HMAC_SECRET`) and the serial, so a database leak yields
  /// no device key — because no device key is in the database. See
  /// docs/device-protocol.md §2.2.
  credentialHash String?
  /// When the credential was issued, for the admin panel. Null until provisioned.
  credentialIssuedAt DateTime?
  /// Which `keyVersion` this device's `K_d` was derived at, so the master
  /// secret can be rotated without a flag day: the server signs with the
  /// version the device actually holds. See §2.2.
  commandKeyVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events           DeviceEvent[]
  unlockChallenges UnlockChallenge[]
  bookings         Booking[]
  commands         Command[]

  /// Supports the "oldest AVAILABLE first" device pick.
  ///
  /// `size` leads because the pick now always filters on it — a renter asks for
  /// a size before a duration — and `createdAt` trails so the chosen size is
  /// still allocated oldest-first within itself. The two-column form above is
  /// kept for the admin inventory list, which filters on status alone.
  @@index([status, createdAt])
  @@index([status, size, createdAt])
}

/// One row per lock/unlock event, append-only.
///
/// Separate from AuditLog on purpose: AuditLog is the internal security trail
/// (admin actions, failed logins, origin rejections) and is not shown to
/// users. This table is the **user-visible** activity feed that the /history
/// page will render, so it carries only what an owner should see.
///
/// Never holds an OTP, a hash of one, or any credential.
model DeviceEvent {
  id       String            @id @default(cuid())
  deviceId String
  userId   String
  type     DeviceEventType
  source   DeviceEventSource @default(WEB)

  /// Why an UNLOCK_FAILED failed. Null for every other type, and null on rows
  /// written before this column existed — deliberately not backfilled.
  failureReason UnlockFailureReason?

  /// The X-Request-Id of the request that caused this, so a user-visible
  /// event can be tied back to its server log lines. **Internal only** — it is
  /// in no `select` the /history endpoint uses.
  requestId String?

  createdAt DateTime @default(now())

  device           Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications    Notification[]
  outboundMessages OutboundMessage[]

  /// The /history page's query: one user's events, newest first.
  ///
  /// `id` is part of the index because the page is keyset-paginated on
  /// `(createdAt DESC, id DESC)` — `createdAt` alone is not unique, and two
  /// events sharing a timestamp across a page boundary would otherwise be
  /// skipped or returned twice. See docs/decisions.md.
  @@index([userId, createdAt, id])
  @@index([deviceId, createdAt])
}

/// An in-app notification for one user.
///
/// Written in the **same transaction** as the device event it describes, so
/// there can never be a notification about an unlock that did not happen, nor
/// an unlock the owner was not told about. See lib/notifier/.
///
/// Carries no message text: the wording comes from NOTIFICATION_COPY in
/// @safelock/shared at render time, so copy can be fixed without a migration
/// and nothing user-supplied is ever stored here.
model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  /// The event that caused this. Nullable so a future notification that is not
  /// about a device event (an allocation, say) fits without a schema change.
  deviceEventId String?

  createdAt DateTime  @default(now())
  /// Null while unread. Marking read is idempotent — only null rows are moved.
  readAt    DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceEvent DeviceEvent? @relation(fields: [deviceEventId], references: [id], onDelete: SetNull)

  /// The bell's query: this user's notifications, unread first, newest first.
  @@index([userId, readAt, createdAt])
}

/// An outstanding phone-verification code.
///
/// Separate from `UnlockChallenge`, which is bound to a device — this one is
/// bound to a *candidate number*, and that difference is the point: the number
/// being verified is held **here** and only written to `User.phone` once the
/// code is confirmed. So changing a verified number leaves the old one live
/// and receiving codes until the new one is proved, and an abandoned change
/// costs the user nothing.
///
/// Only an HMAC of the code is stored, under the same `OTP_HMAC_SECRET` and
/// for the same reason as `UnlockChallenge`: a 6-digit space is 10^6, so the
/// key living outside the database is what protects the digest.
model PhoneVerification {
  id     String @id @default(cuid())
  userId String

  /// The number being verified, E.164. Not yet on the `User` row.
  phoneE164 String

  /// HMAC-SHA256(code, OTP_HMAC_SECRET), hex.
  otpHash String

  expiresAt DateTime
  attempts  Int       @default(0)
  /// Set on success, **or** when a newer request superseded this one.
  consumedAt DateTime?

  /// Captured at request time for the audit trail, never for auth.
  requestedIp String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding the one open verification for a user.
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// An outstanding unlock OTP.
///
/// Only an HMAC of the code is stored — never the code itself. A 6-digit
/// space is just 10^6, so a slow hash buys little; what protects it is a key
/// (OTP_HMAC_SECRET) held outside the database. See docs/decisions.md.
model UnlockChallenge {
  id       String @id @default(cuid())
  userId   String
  deviceId String

  /// HMAC-SHA256(code, OTP_HMAC_SECRET), hex. The plaintext code exists only
  /// in memory and in the notification, never at rest.
  otpHash String

  expiresAt DateTime
  /// Wrong guesses so far. At OTP_MAX_ATTEMPTS the challenge is dead.
  attempts  Int       @default(0)
  /// Set when the code **opened a safe**, or when the challenge was superseded
  /// by a newer request. Either way it can never be used again.
  ///
  /// Under MQTT a correct code no longer opens a safe by itself — it buys a
  /// command, and a command can fail after the code was right. So this is
  /// stamped when the device *acks*, not when the code is verified. See
  /// `commandId` below and docs/device-protocol.md §5.6.
  consumedAt DateTime?

  /// The command this code is currently backing, if any.
  ///
  /// **Bound at confirm, consumed at ack, released on a demonstrated
  /// failure.** The conditional update that sets this from null is the
  /// serialisation point: exactly one of N concurrent confirms wins, so exactly
  /// one command is ever created and the loser sees `OTP_NOT_FOUND` — the same
  /// property the old `consumedAt: null` claim had.
  ///
  /// Released (back to null) when the command demonstrably did not open
  /// anything: `REJECTED`, `FAILED`, `EXPIRED`, or `TIMED_OUT` — the last in
  /// the *same transaction* as the status change, so a finished command and a
  /// reusable code become true together. Burning someone's code for our motor
  /// fault would charge them for our hardware's mistake.
  ///
  /// Single-use stays literally true: what is reusable is a code that
  /// demonstrably opened nothing, which is not a used code. And a release is
  /// provisional — if a late ack later proves the bolt moved, `consumedAt` is
  /// stamped and the code dies, whether or not it was handed out again (§5.5).
  commandId String? @unique

  /// How many commands this one code has backed. Capped at
  /// `CHALLENGE_MAX_BINDS`, or a jammed motor and a determined user could spawn
  /// commands until the code expired. Nothing about the code is *extended* to
  /// make rebinding work: `expiresAt` and `attempts` are untouched, so five
  /// guesses inside five minutes is still exactly what an attacker gets.
  binds Int @default(0)

  createdAt DateTime @default(now())

  device  Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  command Command? @relation(fields: [commandId], references: [id], onDelete: SetNull)

  /// Finding the one open challenge for a user's device.
  @@index([userId, deviceId, consumedAt])
  @@index([expiresAt])
}

/// One instruction sent to one safe.
///
/// ## Why this table exists now and did not before
/// The mock gateway acked synchronously and always, so there was nothing in
/// flight: a command was a function call that had already finished by the time
/// it returned. MQTT is a different world — a publish can be lost, delayed,
/// duplicated or answered after we gave up — so a command acquires a life of
/// its own, and a life needs a row. See docs/decisions.md.
///
/// ## Three invariants it carries
/// 1. **Nothing is published inside a transaction.** The row is committed
///    `PENDING`, then published; a rollback cannot un-publish, and a
///    transaction that waits on a radio makes a network outage fatal — and
///    holds the device row lock across it, serialising the whole fleet behind
///    one slow safe.
/// 2. **`seq` is allocated under the device row lock**, so two concurrent taps
///    cannot be handed the same number, and the device can reject anything at
///    or below the highest it has seen. That, not the clock, is what makes a
///    captured command unreplayable.
/// 3. **`Device.lockState` moves on the ack this row records, never on the
///    publish.** A safe recorded as locked has reported itself locked.
///
/// ## One constraint Prisma cannot express
/// A raw-SQL partial unique index, `Command_one_live_system_per_device`, allows
/// at most one live (`PENDING`/`SENT`) command per device **among system
/// commands**. Without it a safe wedged open would spawn a fresh reconcile on
/// every 60-second heartbeat — an unbounded fan-out aimed at the one device
/// least able to answer. User commands are outside it on purpose: they are
/// answered rather than retried, and two tabs racing are already serialised by
/// the device row lock. See the migration.
model Command {
  id       String @id @default(cuid())
  deviceId String

  /// The booking this was issued for. Null for a system command — a completion
  /// lock, a reconcile, an admin action — which is exactly the set of commands
  /// nobody is waiting on, and therefore the set that may retry.
  bookingId String?

  /// Which unlock code bought this command. Historical, and never cleared.
  ///
  /// Deliberately **not** the inverse of `UnlockChallenge.commandId`, which is
  /// a different fact: that column says which command a code is *currently*
  /// backing and is cleared on release, because it is the serialisation point
  /// for "exactly one concurrent confirm wins". This one says which code a
  /// command *came from* and survives the release — which is what lets a late
  /// ack find the code it must now consume, minutes after a timeout unbound
  /// it. One column could not be both: a mutable claim and an immutable
  /// record. See docs/device-protocol.md §5.5.
  challengeId String?

  type   CommandType
  status CommandStatus @default(PENDING)

  /// Monotonic per device. See invariant 2 above.
  seq Int

  /// Publish attempts. A user command gets one — a person is standing there,
  /// and a silent retry would answer a question they have already stopped
  /// asking. A system LOCK retries up to `COMMAND_MAX_ATTEMPTS`.
  attempts Int @default(0)

  issuedAt DateTime @default(now())
  /// `issuedAt + COMMAND_TTL_MS`. The **server's** authority on "too late";
  /// the device enforces its own `ttlMs` from a monotonic counter, because a
  /// freshly booted ESP32 has no trusted wall clock.
  expiresAt DateTime
  sentAt    DateTime?
  ackedAt   DateTime?

  /// Set when the ack arrived after this row was already `TIMED_OUT`.
  ///
  /// The physical record is still updated from the measurement — the safe's
  /// actual state is not in dispute just because our timer expired — but the
  /// row remembers that we had already told the user it failed. A dashboard
  /// showing "failed" and a database saying "acked", with nothing explaining
  /// the gap, is an unexplainable contradiction. See §5.5.
  lateAckedAt DateTime?

  failureCategory CommandFailureCategory?

  /// Who asked. **Exactly one of `userId` and `systemActor` is set**, which is
  /// also the test for "is anyone waiting on this".
  userId      String?
  systemActor CommandActor?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// At most one challenge is ever bound to a command. The unique side of the
  /// relation lives on `UnlockChallenge.commandId`.
  challenge UnlockChallenge?

  /// The database insisting on what the row lock computes.
  @@unique([deviceId, seq])
  /// The timeout sweeper's query.
  @@index([status, expiresAt])
  /// The admin "recent commands" expander, and the consecutive-failure count.
  @@index([deviceId, issuedAt])
  /// Finding a user's in-flight command for the status endpoint.
  @@index([userId, issuedAt])
}

/// One row per issued refresh token.
///
/// Refresh tokens are **opaque random bytes**, not JWTs, so they can be
/// revoked server-side the instant theft is suspected. Only the SHA-256 of the
/// token is stored: a database leak therefore yields no usable session.
///
/// Rotation: redeeming a token revokes it and links the successor through
/// `replacedById`. Tokens sharing a `familyId` are one login's chain — if a
/// revoked token is replayed outside the grace window the whole family is
/// revoked at once. See refreshToken.service.ts.
model RefreshToken {
  id String @id @default(cuid())

  userId String
  /// SHA-256 hex of the opaque token. Unique so a hash collision or a double
  /// insert cannot produce two live rows for one secret. The raw token is
  /// never stored, logged, or recoverable from this row.
  tokenHash String @unique
  /// Shared by every token descended from one login.
  familyId  String

  expiresAt DateTime
  revokedAt DateTime?
  /// Why it was revoked — specifically, whether a replay is theft. See the
  /// enum. Null for a live token, and for rows revoked before the column
  /// existed.
  revokedReason RefreshTokenRevokedReason?
  /// The token issued when this one was redeemed.
  replacedById String?
  /// Set when this already-revoked token was replayed inside the grace window
  /// and allowed to mint one sibling. A second such replay is treated as
  /// reuse: at most one sibling per rotated token.
  graceUsedAt DateTime?

  /// Captured at issue time to make an audit trail useful, never for auth.
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// The WhatsApp outbox: one row per message we intend to send.
///
/// ## Why an outbox exists at all
/// A WhatsApp send is a network call, and the unlock flow writes its
/// `DeviceEvent` and in-app `Notification` inside a transaction. Sending from
/// inside that transaction would be wrong in both directions: a rollback
/// cannot unsend a message (so someone could be told their safe opened when it
/// did not), and a WhatsApp outage would roll back the unlock (so the safe
/// would refuse to open because a *notification* channel was down).
///
/// Writing a row is a local insert, so it stays atomic with the event. The
/// worker sends after the commit. That reverses the step-2 trade-off — where a
/// notifier failure deliberately blocked the unlock — **for the external
/// channel only**. The in-app notification is still atomic and still blocking.
/// See docs/decisions.md.
///
/// ## What it never holds
/// No message text and no template parameters. Parameters can contain a
/// one-time code, so they are rebuilt from live data at send time
/// (`lib/whatsapp/send.ts`) and exist only in memory. A dump of this table
/// yields who was messaged about what, and no codes.
///
/// ## Scheduling is a due time, not a job queue
/// A row may be queued now and due later (`sendAt`). Nothing re-reads a
/// booking to decide *whether* to schedule — `dedupeKey` makes that
/// idempotent — and nothing trusts the schedule at send time either: a row
/// carrying a `bookingId` is re-validated against the live booking, and a
/// booking that moved on yields `SKIPPED`, never a message. Cancellation at
/// the state change and re-validation at send are independent, exactly like
/// the two unlock-eligibility guards.
model OutboundMessage {
  id     String              @id @default(cuid())
  userId String
  kind   OutboundMessageKind

  status   OutboundMessageStatus   @default(PENDING)
  /// Delivery attempts so far. Compared against OUTBOX_MAX_ATTEMPTS.
  attempts Int                     @default(0)
  /// Why it failed or was skipped. Null while PENDING or once SENT.
  failureCategory OutboundFailureCategory?

  /// Earliest time the worker may try again. Exponential backoff.
  nextAttemptAt DateTime @default(now())

  /// When this message is **due**.
  ///
  /// Distinct from `nextAttemptAt`, and the distinction is the point:
  /// `sendAt` is the moment the message is *about* and never moves once the
  /// row exists, while `nextAttemptAt` is retry backoff and only ever moves
  /// forward. The claim query requires both to have elapsed, so a backoff can
  /// never pull a message earlier than its due time. Immediate kinds leave it
  /// at `now()` and behave exactly as before.
  sendAt DateTime @default(now())

  /// The booking a scheduled lifecycle message belongs to.
  ///
  /// Null for every pre-rental kind — an unlock alert is about a device event,
  /// not a rental. Non-null is also the flag the worker branches on: a row
  /// with a booking is re-validated against it, and is subject to the
  /// staleness tolerance and the booking send budget.
  bookingId String?

  /// Idempotency key for scheduling, unique across the table.
  ///
  /// Shaped `<bookingId>:<kind>:<discriminator>`, where the discriminator is
  /// the `sendAt` epoch for the deadline kinds, `endsAt` for
  /// `BOOKING_CONFIRMED` and the payment id for `OVERSTAY_SETTLED` —
  /// deliberately **not** "now", or settlement running twice (the verified
  /// callback *and* the webhook) would send two messages. Scheduling is
  /// therefore a `createMany({ skipDuplicates: true })` and needs no prior
  /// read.
  ///
  /// Null for non-booking messages, and Postgres treats NULLs as distinct, so
  /// the unique index does not constrain them.
  ///
  /// A cancelled (`SKIPPED`) row keeps its key, so re-creating that exact key
  /// is silently dropped. Reachable only by returning a booking to a state it
  /// already left at the same timestamp: an extension adds whole hours, and
  /// the leads are 30 and 10 minutes, so every re-scheduled key differs. See
  /// docs/decisions.md.
  dedupeKey String? @unique

  /// Meta's `wamid.…`, once accepted. The key a delivery webhook matches on.
  providerMessageId String? @unique
  /// Delivery state reported by the webhook: sent / delivered / read / failed.
  deliveryStatus    String?
  deliveryUpdatedAt DateTime?

  /// The device event this message is about, when there is one.
  deviceEventId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceEvent DeviceEvent? @relation(fields: [deviceEventId], references: [id], onDelete: SetNull)
  booking     Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  /// The worker's claim query: PENDING rows whose backoff has elapsed.
  @@index([status, nextAttemptAt])
  /// The same claim query's other half, and its `ORDER BY sendAt`.
  @@index([status, sendAt])
  /// The daily cap count, and a user's message history.
  @@index([userId, createdAt])
  /// `cancelPending` for one booking.
  @@index([bookingId, status])
}

/// One rental of one safe.
///
/// ## The device is held from creation, not from payment
/// `PENDING_PAYMENT` reserves the safe for `holdExpiresAt`, so a user who pays
/// is never told "sorry, gone". The obvious abuse — opening many unpaid
/// bookings to drain the pool — is closed by one live booking per user (the
/// partial unique index below) plus rate limits.
///
/// ## The clock starts when the money lands
/// `endsAt` is **null while pending** and set at activation to
/// `paidAt + hours`, so nobody loses purchased time to a slow checkout.
/// `reservedUntil` is what the overlap constraint uses, and it covers the
/// grace period and collection window too: the safe may still physically hold
/// someone's belongings for all of it.
///
/// ## Overlap is a database constraint, not a service check
/// A raw-SQL migration adds
/// `EXCLUDE USING gist (deviceId WITH =, tstzrange(startsAt, reservedUntil) WITH &&)`
/// over the occupying statuses. Prisma cannot model it, so it lives in the
/// migration — and it is the only thing that makes concurrent booking correct,
/// exactly as `Device.ownerId`'s unique index used to be for allocation.
model Booking {
  id       String @id @default(cuid())
  userId   String
  deviceId String

  status BookingStatus @default(PENDING_PAYMENT)

  /// Hours purchased. Extensions add to it.
  hours Int

  startsAt DateTime
  /// Null until activation: the clock starts when the payment is captured.
  endsAt   DateTime?
  /// When an unpaid hold lapses. Null once paid.
  holdExpiresAt DateTime?
  /// How long the device is unavailable to anyone else. The constraint's upper
  /// bound. Extended by an extension, and by the sweeper during an overstay so
  /// a physically occupied safe stays unbookable.
  reservedUntil DateTime

  /// Total charged for the booking and its extensions, in paise.
  pricePaise Int
  currency   String @default("INR")

  /// --- Rate snapshot. Config changes must never re-price a live booking. ---
  ///
  /// The size is part of the snapshot for exactly the same reason the rate is:
  /// an admin re-classifying a cabinet mid-rental must not retroactively change
  /// what the renter is recorded as having booked. `Device.size` is a fact about
  /// inventory; this is a fact about the contract.
  safeSize                SafeSize @default(MEDIUM)
  hourlyRatePaise         Int
  /// Basis points: 15000 = 1.5x. Never a float.
  overstayMultiplierBps   Int
  graceMinutes            Int
  capHours                Int
  collectionWindowMinutes Int

  /// When an overstay fee was captured, opening the collection window.
  overstaySettledAt DateTime?
  /// What was actually collected for the overstay, in paise. For the books.
  overstayPaidPaise Int       @default(0)
  /// Set when an admin waived the fee instead of collecting it.
  overstayWaivedAt  DateTime?

  completedAt      DateTime?
  completionReason BookingCompletionReason?
  /// Admin reason for a force-complete or a waive. Audited as well.
  adminNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  payments Payment[]
  /// Scheduled lifecycle messages. Cascade-deleted with the booking, which is
  /// the right answer for a nudge toward a page that no longer exists.
  outboundMessages OutboundMessage[]

  /// The sweeper's query: non-terminal bookings with a deadline behind them.
  @@index([status, endsAt])
  @@index([status, holdExpiresAt])
  /// A user's booking history, and the current-booking lookup.
  @@index([userId, createdAt])
  @@index([deviceId, reservedUntil])
}

/// An outstanding password reset code.
///
/// Replaces the long-token link of step 3. The token was 32 random bytes in a
/// URL, which nothing could deliver: the WhatsApp message deliberately carries
/// no token (a chat message is persistent and forwardable), and there is no
/// email sender. An undeliverable credential is unreachable auth surface, so
/// it is gone. See docs/decisions.md.
///
/// `codeHash` is `HMAC-SHA256("pwreset:v1:" + code, OTP_HMAC_SECRET)`. **Keyed,
/// unlike the token it replaces** — and for the reason the step 3 entry gave
/// for *not* keying it: an unkeyed hash is reversible exactly when the input
/// space is small enough to enumerate, and 10^8 is. The `pwreset:v1:` prefix
/// is domain separation, so a reset digest can never equal an unlock digest for
/// the same digits even though both use the same secret.
///
/// There is no unique index on `codeHash`: codes are looked up by `userId`
/// (resolved from the submitted identifier), and two users may legitimately
/// hold the same 8 digits.
model PasswordResetCode {
  id     String @id @default(cuid())
  userId String

  /// HMAC of the code. The code itself exists only in memory and in the
  /// message — never stored, never logged, never in a response.
  codeHash String

  expiresAt DateTime
  /// Wrong guesses so far. **Load-bearing**: an 8-digit code is only safe
  /// because this is enforced atomically, in the `where` of the incrementing
  /// update. See passwordReset.service.ts.
  attempts  Int       @default(0)
  /// Set on success, when the attempt limit is burned, or when a newer request
  /// superseded this one. Either way it can never be used again.
  consumedAt DateTime?

  /// Captured at request time for the audit trail, never for auth.
  requestedIp String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding a user's one open code.
  @@index([userId, consumedAt])
  @@index([expiresAt])
}

/// One row per Razorpay order. Amounts are integers in paise — never floats.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  /// Set when the payment first reaches PAID, by whichever of
  /// /payments/verify or the webhook gets there first.
  paidAt            DateTime?

  /// What this payment buys. Every payment belongs to a booking now — there
  /// is no account-level activation any more.
  purpose   PaymentPurpose
  bookingId String?

  /// For an OVERSTAY payment: when its quote stops being honoured.
  ///
  /// The fee keeps accruing while the user is at the checkout, so the quote is
  /// binding for a bounded window and the order carries the same expiry. A
  /// capture after this instant whose amount no longer covers the fee is
  /// **not** settled silently — it is flagged below.
  quoteExpiresAt DateTime?

  /// Set when the money arrived but could not be applied. The row stays PAID.
  reviewReason   PaymentReviewReason?
  /// Set when an admin has dealt with it (refunded by hand, note audited).
  reviewClearedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([bookingId])
  /// The admin "needs refund" list.
  @@index([reviewReason, reviewClearedAt])
}

/// Razorpay webhook idempotency ledger. A delivery whose event id is already
/// here is acknowledged and dropped without being applied a second time.
model WebhookEvent {
  id          String   @id @default(cuid())
  /// Razorpay's `x-razorpay-event-id` header.
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  deviceId  String?
  action    String
  ip        String?
  userAgent String?
  /// Never holds secrets, signatures or OTPs — see audit.service.ts.
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
