// Safe Lock platform — database schema.
//
// Scope note: users, payments, device inventory/allocation and the lock/unlock
// flow are all here. `Command` (see CLAUDE.md "Data Model") is deliberately
// absent — the mock gateway acks synchronously, so there is nothing to track
// asynchronously or time out yet. It lands with the real MQTT gateway.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum DeviceStatus {
  UNASSIGNED
  ASSIGNED
  RETIRED
}

enum LockState {
  LOCKED
  UNLOCKED
  /// Only for a device nobody owns. An allocated safe is never UNKNOWN —
  /// allocation sets LOCKED, unassign sets it back to UNKNOWN.
  UNKNOWN
}

/// What happened to a safe. Append-only; the /history page reads these.
enum DeviceEventType {
  LOCK
  /// A one-time code was sent. Nothing has opened at this point.
  UNLOCK_REQUESTED
  UNLOCK_CONFIRMED
  /// A wrong, expired or exhausted code.
  UNLOCK_FAILED
}

/// Where a device event came from. Mobile and hardware join this later.
enum DeviceEventSource {
  WEB
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // TODO(phone-verification): add `phoneVerifiedAt DateTime?` when WhatsApp /
  // SMS verification is built. Deliberately absent for now so no route can
  // start depending on a column that is never populated.

  payments          Payment[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  deviceEvents      DeviceEvent[]
  unlockChallenges  UnlockChallenge[]
  /// At most one, enforced by the unique constraint on Device.ownerId.
  device            Device?
}

/// A physical safe lock in the inventory.
model Device {
  id           String       @id @default(cuid())
  serialNumber String       @unique
  status       DeviceStatus @default(UNASSIGNED)
  /// A safe ships locked, so a device in stock defaults to LOCKED and
  /// allocation re-asserts it. The UI must show the device's actual state,
  /// never "what the last button press implied" — hence lockStateUpdatedAt,
  /// which is set only when a command is *acked*, not when one is sent.
  lockState           LockState @default(LOCKED)
  lockStateUpdatedAt  DateTime?
  online              Boolean   @default(false)
  lastSeenAt          DateTime?

  /// Unique: a user owns at most one device for now. The constraint, not just
  /// a service check, is what makes concurrent allocation safe.
  ownerId     String?   @unique
  allocatedAt DateTime?

  /// Reserved for the hardware phase: a hash or key-reference for per-device
  /// credentials. **Never populated or returned by any endpoint today**, and
  /// excluded from every `select` list. No device secrets are stored yet.
  credentialHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  events           DeviceEvent[]
  unlockChallenges UnlockChallenge[]

  /// Supports the "oldest UNASSIGNED first" allocation pick.
  @@index([status, createdAt])
}

/// One row per lock/unlock event, append-only.
///
/// Separate from AuditLog on purpose: AuditLog is the internal security trail
/// (admin actions, failed logins, origin rejections) and is not shown to
/// users. This table is the **user-visible** activity feed that the /history
/// page will render, so it carries only what an owner should see.
///
/// Never holds an OTP, a hash of one, or any credential.
model DeviceEvent {
  id       String            @id @default(cuid())
  deviceId String
  userId   String
  type     DeviceEventType
  source   DeviceEventSource @default(WEB)

  /// The X-Request-Id of the request that caused this, so a user-visible
  /// event can be tied back to its server log lines.
  requestId String?

  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The /history page's query: one user's events, newest first.
  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

/// An outstanding unlock OTP.
///
/// Only an HMAC of the code is stored — never the code itself. A 6-digit
/// space is just 10^6, so a slow hash buys little; what protects it is a key
/// (OTP_HMAC_SECRET) held outside the database. See docs/decisions.md.
model UnlockChallenge {
  id       String @id @default(cuid())
  userId   String
  deviceId String

  /// HMAC-SHA256(code, OTP_HMAC_SECRET), hex. The plaintext code exists only
  /// in memory and in the notification, never at rest.
  otpHash String

  expiresAt DateTime
  /// Wrong guesses so far. At OTP_MAX_ATTEMPTS the challenge is dead.
  attempts  Int       @default(0)
  /// Set when the code was accepted, or when the challenge was superseded by
  /// a newer request. Either way it can never be used again.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Finding the one open challenge for a user's device.
  @@index([userId, deviceId, consumedAt])
  @@index([expiresAt])
}

/// One row per issued refresh token.
///
/// Refresh tokens are **opaque random bytes**, not JWTs, so they can be
/// revoked server-side the instant theft is suspected. Only the SHA-256 of the
/// token is stored: a database leak therefore yields no usable session.
///
/// Rotation: redeeming a token revokes it and links the successor through
/// `replacedById`. Tokens sharing a `familyId` are one login's chain — if a
/// revoked token is replayed outside the grace window the whole family is
/// revoked at once. See refreshToken.service.ts.
model RefreshToken {
  id String @id @default(cuid())

  userId String
  /// SHA-256 hex of the opaque token. Unique so a hash collision or a double
  /// insert cannot produce two live rows for one secret. The raw token is
  /// never stored, logged, or recoverable from this row.
  tokenHash String @unique
  /// Shared by every token descended from one login.
  familyId  String

  expiresAt DateTime
  revokedAt DateTime?
  /// The token issued when this one was redeemed.
  replacedById String?
  /// Set when this already-revoked token was replayed inside the grace window
  /// and allowed to mint one sibling. A second such replay is treated as
  /// reuse: at most one sibling per rotated token.
  graceUsedAt DateTime?

  /// Captured at issue time to make an audit trail useful, never for auth.
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

/// One row per Razorpay order. Amounts are integers in paise — never floats.
model Payment {
  id                String        @id @default(cuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  /// Set when the payment first reaches PAID, by whichever of
  /// /payments/verify or the webhook gets there first.
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

/// Razorpay webhook idempotency ledger. A delivery whose event id is already
/// here is acknowledged and dropped without being applied a second time.
model WebhookEvent {
  id          String   @id @default(cuid())
  /// Razorpay's `x-razorpay-event-id` header.
  eventId     String   @unique
  type        String
  processedAt DateTime @default(now())

  @@index([type])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  deviceId  String?
  action    String
  ip        String?
  userAgent String?
  /// Never holds secrets, signatures or OTPs — see audit.service.ts.
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
