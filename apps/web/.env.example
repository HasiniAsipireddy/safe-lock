# Base URL of the Express API (no trailing slash). Includes the /api/v1 prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Fake the API in the browser so the UI can be used without a backend.
# The payment flow works in mock mode too: /pay shows a "Simulate payment"
# button instead of loading Razorpay Checkout.
# DEVELOPMENT ONLY — the app refuses to build or boot with this enabled in production.
NEXT_PUBLIC_USE_MOCK_API=true

# Note: there is no NEXT_PUBLIC_RAZORPAY_KEY_ID on purpose. The key id arrives
# in the POST /payments/order response, so the browser never holds payment
# configuration of its own — and the key SECRET never leaves the server.
